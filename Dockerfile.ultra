# ===== ULTRA-EFFICIENT DOCKERFILE =====

FROM python:3.12-slim

# Install only essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only backend (frontend built externally)
COPY backend/ ./

# Create directories
RUN mkdir -p data staticfiles

# Startup script
RUN echo '#!/bin/bash\n\
echo "🚀 Starting..."\n\
python manage.py migrate --noinput\n\
python manage.py collectstatic --noinput || true\n\
python manage.py shell -c "from django.contrib.auth.models import User; User.objects.filter(username='\''admin'\'').exists() or User.objects.create_superuser('\''admin'\'', '\''admin@restaurant.com'\'', '\''admin123'\'')"\n\
python manage.py runserver 0.0.0.0:8000\n\
' > start.sh && chmod +x start.sh

EXPOSE 8000
CMD ["./start.sh"]