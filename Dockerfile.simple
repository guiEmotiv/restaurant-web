# ===== OPTIMIZED SINGLE-STAGE DOCKERFILE =====

FROM python:3.12-slim

# Install system dependencies in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    nodejs \
    npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

WORKDIR /app

# Copy and install Python packages (cached layer)
COPY backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy frontend package.json first (for caching)
COPY frontend/package*.json ./frontend/
WORKDIR /app/frontend
RUN NODE_OPTIONS='--max-old-space-size=512' npm ci --prefer-offline --no-audit

# Copy frontend source and build
COPY frontend/ ./
RUN NODE_OPTIONS='--max-old-space-size=512' npm run build \
    && rm -rf node_modules \
    && npm cache clean --force

# Copy backend and setup
WORKDIR /app
COPY backend/ ./backend/
RUN mkdir -p /app/data /app/staticfiles

WORKDIR /app/backend

# Create startup script
RUN echo '#!/bin/bash\n\
echo "🚀 Starting Restaurant App..."\n\
python manage.py migrate --noinput\n\
python manage.py collectstatic --noinput || true\n\
python manage.py shell -c "from django.contrib.auth.models import User; User.objects.filter(username='\''admin'\'').exists() or User.objects.create_superuser('\''admin'\'', '\''admin@restaurant.com'\'', '\''admin123'\'')"\n\
echo "✅ Starting server on port 8000..."\n\
python manage.py runserver 0.0.0.0:8000\n\
' > /app/start.sh && chmod +x /app/start.sh

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health/ || exit 1

CMD ["/app/start.sh"]